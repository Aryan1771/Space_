{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Browser From Scratch",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/build.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run Browser From Scratch",
      "type": "shell",
      "command": "${workspaceFolder}/build/browser.exe",
      "dependsOn": "Build Browser From Scratch",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    }
  ]
}
