{
  "name": "space-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Space_ - Chromium browser with Opera GX inspired UI and Brave style Shields",
  "main": "dist/main/index.js",
  "author": "Aryan",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on tcp:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "pack": "npm run build && electron-builder --dir",
    "installer": "npm run pack && powershell -NoProfile -ExecutionPolicy Bypass -File installer/build-installer.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "start": "electron ."
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "electron-store": "^10.1.0",
    "lucide-react": "^1.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tldts": "^7.0.10",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.space.browser",
    "productName": "Space_",
    "copyright": "Copyright (c) 2026 Aryan",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-256.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Space_-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Space_",
      "license": "installer/LICENSE.txt",
      "deleteAppDataOnUninstall": false
    }
  }
}
